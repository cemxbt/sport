NODE_ENV=development
PORT=3000
GITHUB_TOKEN=
GITHUB_REPO=cemxbt/sport

# Iletisim formu — Render icin ONERILEN: Resend (HTTP API, SMTP engeli yok)
# https://resend.com — API key olustur, domain ekle, asagiyi doldur
RESEND_API_KEY=
# Dogrulanmis domainden gonderim: Ornek Iletisim <iletisim@ibrahimersoran.com>
# Test icin: Iletisim <onboarding@resend.dev> (sadece kayitli adrese gidebilir)
RESEND_FROM=

# Alternatif: Hostinger SMTP (Render bazi IPlerden baglanamayabilir → HTTP 500)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CONTACT_MAIL_TO=iletisim@ibrahimersoran.com
# Bu adrese (virgulle birden fazla) her zaman ek kopya gider; bos birakmak icin CONTACT_MAIL_ALSO=
CONTACT_MAIL_ALSO=ibrahimersoran@hotmail.com
CONTACT_MAIL_FROM=
